# ---------------------------------------------------------------------------
# Backend (loaded by backend/app/core/config.py)
# ---------------------------------------------------------------------------

# Shown in emails and the OpenAPI title
APP_NAME=SaaS Starter

# development | production | test
APP_ENV=development

# Used to sign OAuth state and other short-lived values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/saas_starter

# Public URLs. FRONTEND_URL is used for CORS, CSRF origin checks, email links
# and OAuth redirects. Comma-separate extra origins in CORS_ORIGINS if needed.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=

# Sessions
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=14

# Google OAuth (see README -> "Google OAuth setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Providers: console (prints to logs), smtp, resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=SaaS Starter
# Only for EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Frontend (Vite only exposes variables prefixed with VITE_)
# Copy to frontend/.env (or export) — Vite reads frontend/.env, not this file.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
